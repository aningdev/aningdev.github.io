    "@fontsource-variable/newsreader": "^5.3.0",
    "@playform/compress": "^0.2.5",
    "astro": "^7.4.4",
    "astro-expressive-code": "^0.44.3",
    "astro-seo-schema": "^7.0.1",
    "hastscript": "^9.0.3",
    "katex": "^0.19.1",
    "mdast-util-directive": "^3.2.0",
    "mdast-util-to-markdown": "^2.2.1",
