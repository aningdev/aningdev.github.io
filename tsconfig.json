{
	"extends": "astro/tsconfigs/strict",
	"include": [".astro/types.d.ts", "**/*"],
	"exclude": ["dist"],
	"compilerOptions": {
		"paths": {
			"@/assets/*": ["./src/assets/*"],
			"@/components/*": ["./src/components/*"],
			"@/data/*": ["./src/data/*"],
			"@/layouts/*": ["./src/layouts/*"],
			"@/utils/*": ["./src/utils/*"],
			"@/types": ["./src/types.ts"],
			"@/site-config": ["./src/site.config.ts"]
		}
	}
}
